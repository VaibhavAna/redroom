PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/redroom

# Runs every 6 hours by default. Set to false to disable scheduled tracking.
PRICE_TRACKER_CRON_ENABLED=true
PRICE_CHECK_CRON=0 */6 * * *

# SMTP settings for email alerts.
# Gmail users usually need an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=RedRoom <your-email@gmail.com>
